---
import { getBlogCollection } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getCourseGroups, isCourseNote } from '@/utils/course-notes'

export const prerender = true

const coursePosts = (await getBlogCollection()).filter(isCourseNote)
const courseGroups = getCourseGroups(coursePosts)

const meta = {
  description: '按课程整理的学习笔记、课件摘要与复习资料',
  title: 'Course Notes'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-3 mt-6 text-3xl font-medium sm:mt-10'>Course Notes</h1>
      <p class='max-w-2xl text-muted-foreground'>
        课程笔记单独归档在这里，按课程目录组织，和日常 blog、论文阅读、教程记录分开浏览。
      </p>
    </div>

    {
      courseGroups.length === 0 ? (
        <p class='mt-8'>No course notes yet.</p>
      ) : (
        <section
          id='content'
          class='animate mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3'
          aria-label='Course list'
        >
          {courseGroups.map(({ course, posts }) => (
            <article class='scroll-reveal rounded-lg border bg-background p-5 transition-colors hover:bg-muted'>
              <a href={`/notes/${course.slug}`} class='group flex h-full flex-col' data-astro-prefetch>
                <div class='flex items-start justify-between gap-3'>
                  <h2 class='flex items-center text-xl font-medium group-hover:text-primary'>
                    <Icon name='document' class='me-2 size-5 shrink-0' />
                    {course.title}
                  </h2>
                  <span class='shrink-0 rounded-full border px-2.5 py-1 text-xs text-muted-foreground'>
                    {posts.length} notes
                  </span>
                </div>
                <p class='mt-3 text-sm leading-6 text-muted-foreground'>{course.description}</p>
                <ul class='mt-5 flex flex-col gap-y-2 text-sm'>
                  {posts.slice(0, 4).map((post) => (
                    <li class='line-clamp-1 text-muted-foreground'>{post.data.title}</li>
                  ))}
                </ul>
                <span class='mt-5 inline-flex items-center self-end text-sm font-medium group-hover:text-primary'>
                  View course →
                </span>
              </a>
            </article>
          ))}
        </section>
      )
    }
  </main>
</PageLayout>
