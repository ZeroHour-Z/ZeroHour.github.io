---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'
import { courses, getCourseInfo, getCourseSlug, sortCoursePosts } from '@/utils/course-notes'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getBlogCollection()) as CollectionEntry<'blog'>[]

  return courses.flatMap((course) => {
    const posts = sortCoursePosts(allPosts.filter((post) => getCourseSlug(post) === course.slug))
    return paginate(posts, {
      pageSize: config.content.blogPageSize,
      params: { course: course.slug },
      props: { course }
    })
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props
const courseSlug = Astro.params.course ?? ''
const course = getCourseInfo(courseSlug)

const meta = {
  description: course?.description ?? 'Course notes',
  title: course?.title ?? 'Course Notes'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Notes`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Notes →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/notes' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-3 text-3xl font-medium'>{course?.title ?? 'Course Notes'}</h1>
      {course?.description && <p class='max-w-2xl text-muted-foreground'>{course.description}</p>}
    </div>

    <section id='content' class='animate mt-8' aria-label='Course notes list'>
      <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
        <span class='text-muted-foreground'>
          Page {page.currentPage} - Showing {page.data.length} of {page.total} notes
        </span>
      </div>
      <ul class='flex flex-col gap-y-3 text-start'>
        {page.data.map((post) => <PostPreview as='h2' {post} detailed />)}
      </ul>
      <Paginator {...paginationProps} />
    </section>
  </main>
</PageLayout>
